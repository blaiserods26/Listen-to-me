# ==========================================
# Target Website(s) to Monitor
# ==========================================

# Option 1: Multiple URLs (comma-separated)
TARGET_URLS=https://example.com, https://news.ycombinator.com

# Option 2: Single URL fallback
TARGET_URL=https://example.com

# Option 3: External JSON file for rich per-site configuration (leave empty if using TARGET_URLS)
# See sites.json.example for format with custom names and CSS selectors per site
SITES_FILE_PATH=

# Global default CSS selector (leave empty to monitor entire page)
# Examples: body, #main-content, article, div.announcements
CSS_SELECTOR=

# Cleaning options (true/false)
# Strips <script>, <style>, and comments to avoid false alarms from tracking codes/timestamps
STRIP_DYNAMIC_TAGS=true

# Polling interval in seconds (default: 3600 = 1 Hour)
CHECK_INTERVAL_SECONDS=3600

# File path to save previous hashes and state
STATE_FILE_PATH=state.json

# ==========================================
# Email / SMTP Settings
# ==========================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
EMAIL_SENDER=your_email@gmail.com
EMAIL_RECIPIENT=recipient@example.com

# Email subject prefix
EMAIL_SUBJECT_PREFIX=[Web-Listener Alert]
